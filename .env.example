# ── Application ───────────────────────────────────────────────
APP_NAME=ComplianceForge
APP_ENV=development
APP_PORT=8080
APP_GRPC_PORT=9090
APP_WORKER_ENABLED=true

# ── PostgreSQL ───────────────────────────────────────────────
# DATABASE_URL takes precedence over the individual DB_* values when set.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=complianceforge
DB_PASSWORD=changeme
DB_NAME=complianceforge
DB_SSL_MODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── Durable notification delivery ───────────────────────────
NOTIFICATION_DELIVERY_TENANT_BATCH=100
NOTIFICATION_DELIVERY_CLAIM_BATCH=100
# Must exceed the maximum provider timeout; validated between 3m and 15m.
NOTIFICATION_DELIVERY_LEASE=3m
NOTIFICATION_RETRY_BASE_DELAY=30s
NOTIFICATION_RETRY_MAX_DELAY=1h
NOTIFICATION_DELIVERY_POLL_INTERVAL=10s

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-secret
JWT_ISSUER=complianceforge
JWT_EXPIRY_HOURS=24

# ── Application-layer encryption ──────────────────────────
# Generate DSR with `openssl rand -base64 32`; generate Integration and
# Notification independently with `openssl rand -hex 32` (never reuse keys).
DSR_ENCRYPTION_KEY=
INTEGRATION_ENCRYPTION_KEY=
# Independent hex-encoded 32-byte key for notification channel secrets.
NOTIFICATION_ENCRYPTION_KEY=

# ── OAuth / SSO ──────────────────────────────────────────────
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback

# ── SMTP / Email ─────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@complianceforge.local
# Use "disabled" only with a local unauthenticated SMTP sink such as Mailpit.
# Staging and production require "starttls" or "implicit".
SMTP_TLS_MODE=disabled
SMTP_TIMEOUT_SECONDS=15
SMTP_HELLO_NAME=
SMTP_SERVER_NAME=

# ── Storage ──────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=eu-west-2

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ── Observability / SRE ─────────────────────────────────────
# Metrics are served only on this dedicated listener; never route port 9091
# through the public ingress. Production requires a root-readable source file
# containing a random bearer token of at least 32 bytes. Compose mounts it into
# API, worker, and Prometheus as /run/secrets/metrics_token.
OBSERVABILITY_METRICS_ENABLED=true
OBSERVABILITY_METRICS_ADDRESS=127.0.0.1:9091
OBSERVABILITY_METRICS_TOKEN_FILE=
OBSERVABILITY_METRICS_TOKEN_SOURCE=
# Enable after an OTLP collector is reachable. The application endpoint is the
# full OTLP/HTTP trace URL; the production collector forwards to the separately
# managed upstream base endpoint below.
OBSERVABILITY_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OBSERVABILITY_TRACE_SAMPLE_RATIO=0.1
OBSERVABILITY_SHUTDOWN_TIMEOUT_SECONDS=10
SERVICE_VERSION=development
OTEL_TRACE_UPSTREAM_ENDPOINT=
OTEL_TRACE_UPSTREAM_AUTHORIZATION=
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3001

# ── HTTP ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=100
# Enable only when every request reaches the API through a trusted proxy that
# overwrites Forwarded/X-Forwarded-* headers (the production nginx does).
API_TRUST_PROXY_HEADERS=false
# Frontend BFF proxy trust is a separate switch. Keep false for direct/local
# access; production Compose enables it only behind the trusted nginx ingress.
TRUST_PROXY_HEADERS=false
# Optional canonical external frontend origin when a trusted proxy cannot
# provide stable X-Forwarded-Host/X-Forwarded-Proto values.
# APP_ORIGIN=https://compliance.example.com

# Staging and production fail closed unless JWT_SECRET is at least 32
# non-default characters, PostgreSQL/Redis/RabbitMQ use TLS, RabbitMQ does not
# use guest credentials, object storage is S3, and all CORS origins use HTTPS.
