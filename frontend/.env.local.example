# Server-only. Never expose the upstream API or bearer credentials to browsers.
API_INTERNAL_URL=http://localhost:8080/api/v1
# Plain HTTP cookies are permitted only when this is development and the
# browser-visible host is loopback. All other environments force Secure.
APP_ENV=development
TRUST_PROXY_HEADERS=false
# Optional strict origin override (scheme + host + optional port only).
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ComplianceForge
NEXT_PUBLIC_APP_VERSION=0.1.0
