    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "10.6.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jest-axe": "11.0.0",
    "jsdom": "28.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
