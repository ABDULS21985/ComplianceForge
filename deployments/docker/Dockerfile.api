# syntax=docker/dockerfile:1.7

FROM golang:1.26.8-alpine3.24@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS builder

RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS=linux
ARG TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/api ./cmd/api
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b AS runtime

RUN apk add --no-cache ca-certificates curl tzdata \
    && addgroup -g 10001 -S complianceforge \
    && adduser -u 10001 -S -D -H -G complianceforge complianceforge

WORKDIR /app
USER 10001:10001

FROM runtime AS api
COPY --from=builder --chown=10001:10001 /out/api /app/api
EXPOSE 8080 9091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "3", "--output", "/dev/null", "http://127.0.0.1:8080/health/ready"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/api"]

FROM runtime AS worker
COPY --from=builder --chown=10001:10001 /out/worker /app/worker
EXPOSE 9091
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "3", "--output", "/dev/null", "http://127.0.0.1:9091/health/ready"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/worker"]

FROM runtime AS migrator
COPY --from=builder --chown=10001:10001 /out/migrate /app/migrate
COPY --chown=10001:10001 sql/migrations /app/sql/migrations
ENTRYPOINT ["/app/migrate"]

# Keep the default build target backwards compatible with existing CI and
# local `docker build` commands, while allowing explicit worker/migrator images.
FROM api AS final
