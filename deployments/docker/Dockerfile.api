# syntax=docker/dockerfile:1.7

FROM golang:1.27.1-alpine3.24@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder

RUN apk add --no-cache ca-certificates git tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY cmd ./cmd
COPY internal ./internal

ARG TARGETOS=linux
ARG TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/api ./cmd/api
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" \
    go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS runtime

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates curl tzdata \
    && addgroup -g 10001 -S complianceforge \
    && adduser -u 10001 -S -D -H -G complianceforge complianceforge

WORKDIR /app
USER 10001:10001

FROM runtime AS api
COPY --from=builder --chown=10001:10001 /out/api /app/api
EXPOSE 8080 9091
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "3", "--output", "/dev/null", "http://127.0.0.1:8080/health/ready"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/api"]

FROM runtime AS worker
COPY --from=builder --chown=10001:10001 /out/worker /app/worker
EXPOSE 9091
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["curl", "--fail", "--silent", "--show-error", "--max-time", "3", "--output", "/dev/null", "http://127.0.0.1:9091/health/ready"]
STOPSIGNAL SIGTERM
ENTRYPOINT ["/app/worker"]

FROM runtime AS migrator
COPY --from=builder --chown=10001:10001 /out/migrate /app/migrate
COPY --chown=10001:10001 sql/migrations /app/sql/migrations
ENTRYPOINT ["/app/migrate"]

# Keep the default build target backwards compatible with existing CI and
# local `docker build` commands, while allowing explicit worker/migrator images.
FROM api AS final
